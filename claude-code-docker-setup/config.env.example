# Copy to config.env and edit plain values. Parsed as data, never sourced.
IMAGE_NAME=agents-research
PROXY_IMAGE_NAME=agents-research-proxy
CODEX_VERSION=0.156.1
CLAUDE_VERSION=2.1.281

# Model for Claude sessions. Empty = account default. Examples: opus, sonnet.
CLAUDE_MODEL=opus
STATA_IMAGE=dataeditors/stata19-se-i-python@sha256:1691fce6250011bef77cb64df58316bc72ed82b9791456e4b804832d9bfd747d
STATA_EDITION=se
GIT_USER_NAME=Research Agent
GIT_USER_EMAIL=research-agent@users.noreply.github.com
MEMORY_LIMIT=16g
CPU_LIMIT=4
PIDS_LIMIT=512
SHM_SIZE=1g
PLATFORM=linux/amd64
PROXY_MAX_REQUESTS_INTERACTIVE=50000
PROXY_MAX_REQUESTS_AUTONOMOUS=50000
MAX_WORKSPACE_MB=4096
